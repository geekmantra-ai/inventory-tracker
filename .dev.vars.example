# Copy this file to .dev.vars for local development

# 1. Cloud MongoDB (MongoDB Atlas)
MONGODB_URI=mongodb://username:password@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017/?ssl=true&replicaSet=atlas-shard-0&authSource=admin
MONGODB_DB_NAME=inventory_platform

# 2. JWT Authentication Secret
JWT_SECRET=your-random-jwt-secret-string

# 3. Product Image Storage — GitHub Repository + jsDelivr CDN
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=your-github-username/your-image-repo-name
GITHUB_BRANCH=main
GITHUB_IMAGE_PATH=product-images
GITHUB_REPO_PRIVATE=false
